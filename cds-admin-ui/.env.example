# Real integration mode.
VITE_AUTH_MODE=keycloak-dpop

# Public Keycloak issuer URL. Must match CDS backend KEYCLOAK_ISSUER_URL.
VITE_KEYCLOAK_ISSUER=https://auth.example.com/realms/cds

# Public SPA client only. Never add a client secret to frontend config.
VITE_KEYCLOAK_CLIENT_ID=cds-admin-ui

# openid is required because the UI validates the returned ID token nonce.
VITE_KEYCLOAK_SCOPE=openid profile email

# Leave empty for same-origin Nginx deployment. The UI will call /v1/device.
VITE_CDS_API_BASE_URL=

# Optional relative callback path. Absolute URLs are intentionally not accepted.
VITE_KEYCLOAK_REDIRECT_PATH=/callback

# Optional relative post-logout path. Absolute URLs are intentionally not accepted.
VITE_KEYCLOAK_POST_LOGOUT_PATH=/

# UI-only dev mode. Mock mode never calls real CDS APIs and fails outside localhost/dev builds.
# VITE_AUTH_MODE=mock
