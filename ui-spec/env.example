# Frontend-only environment variables for CDS Admin UI.
# Do not add Keycloak client secrets here.

# Real mode for backend integration.
VITE_AUTH_MODE=keycloak-dpop

# Public Keycloak issuer URL. This should match CDS backend KEYCLOAK_ISSUER_URL.
# Production example:
# VITE_KEYCLOAK_ISSUER=https://auth.example.com/realms/cds
# Local/dev example if Keycloak is routed by local Nginx:
# VITE_KEYCLOAK_ISSUER=https://auth.localhost/realms/cds
VITE_KEYCLOAK_ISSUER=https://auth.example.com/realms/cds

# Public SPA client. No client secret is allowed in the frontend.
VITE_KEYCLOAK_CLIENT_ID=cds-admin-ui

# Space-delimited scopes. openid is required; profile/email are useful for UI labels.
VITE_KEYCLOAK_SCOPE=openid profile email

# Same-origin API base. Leave empty when Nginx serves the Admin UI and proxies /v1/device.
# The app should then call /v1/device and /v1/device/{serial}.
VITE_CDS_API_BASE_URL=

# Optional explicit redirect URI. If empty, use window.location.origin + /callback or current origin behavior.
VITE_KEYCLOAK_REDIRECT_URI=

# Optional post-logout redirect URI. If empty, use window.location.origin.
VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=

# Optional UI-only mock mode for development before real Keycloak DPoP integration.
# Do not enable mock mode in production.
# VITE_AUTH_MODE=mock
# VITE_MOCK_ACCESS_TOKEN=dev-token
