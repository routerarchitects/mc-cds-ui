{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": {
      "$type": "color",
      "$value": "#f8fafc"
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff"
    },
    "surfaceMuted": {
      "$type": "color",
      "$value": "#f1f5f9"
    },
    "primary": {
      "$type": "color",
      "$value": "#2563eb"
    },
    "primaryHover": {
      "$type": "color",
      "$value": "#1d4ed8"
    },
    "danger": {
      "$type": "color",
      "$value": "#dc2626"
    },
    "dangerHover": {
      "$type": "color",
      "$value": "#b91c1c"
    },
    "success": {
      "$type": "color",
      "$value": "#16a34a"
    },
    "warning": {
      "$type": "color",
      "$value": "#d97706"
    },
    "text": {
      "$type": "color",
      "$value": "#0f172a"
    },
    "textMuted": {
      "$type": "color",
      "$value": "#64748b"
    },
    "border": {
      "$type": "color",
      "$value": "#e2e8f0"
    },
    "focusRing": {
      "$type": "color",
      "$value": "#93c5fd"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif"
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "14px"
      },
      "base": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "weight": {
      "normal": {
        "$type": "fontWeight",
        "$value": "400"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "600"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "700"
      }
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "10px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "14px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "18px"
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": {
        "color": "#0f172a1a",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      }
    }
  },
  "layout": {
    "pageMaxWidth": {
      "$type": "dimension",
      "$value": "1180px"
    },
    "headerHeight": {
      "$type": "dimension",
      "$value": "64px"
    }
  }
}
